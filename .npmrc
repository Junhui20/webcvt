# Allow `pnpm add <pkg>` at the workspace root without the -w flag.
# Needed by cloudflare/wrangler-action, which auto-installs wrangler at the repo
# root during the Pages deploy and otherwise fails with ERR_PNPM_ADDING_TO_ROOT
# in a pnpm workspace. Only affects root-level adds; `pnpm install` and
# `pnpm -r publish` (CI / release) are unaffected.
ignore-workspace-root-check=true
