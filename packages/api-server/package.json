{
  "name": "@catlabtech/webcvt-api-server",
  "version": "0.2.0",
  "description": "Hono-based HTTP convert API for webcvt — runs on Node, Bun, Deno, and Cloudflare Workers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@catlabtech/webcvt-core": "workspace:^",
    "hono": "^4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Junhui20/webcvt.git",
    "directory": "packages/api-server"
  },
  "bugs": {
    "url": "https://github.com/Junhui20/webcvt/issues"
  },
  "homepage": "https://github.com/Junhui20/webcvt/tree/main/packages/api-server#readme",
  "keywords": [
    "webcvt",
    "file-conversion",
    "convert",
    "api",
    "http",
    "hono",
    "server",
    "edge",
    "workers",
    "typescript"
  ]
}
