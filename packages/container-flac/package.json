{
  "name": "@catlabtech/webcvt-container-flac",
  "version": "0.3.0",
  "description": "FLAC (Free Lossless Audio Codec) container muxer and demuxer for webcvt — pure TypeScript, no native dependencies",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@catlabtech/webcvt-core": "workspace:^"
  },
  "devDependencies": {
    "@catlabtech/webcvt-test-utils": "workspace:^",
    "@vitest/coverage-v8": "^2.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Junhui20/webcvt.git",
    "directory": "packages/container-flac"
  },
  "bugs": {
    "url": "https://github.com/Junhui20/webcvt/issues"
  },
  "homepage": "https://github.com/Junhui20/webcvt/tree/main/packages/container-flac#readme",
  "keywords": [
    "webcvt",
    "file-conversion",
    "convert",
    "browser",
    "typescript",
    "flac",
    "audio",
    "lossless"
  ]
}
